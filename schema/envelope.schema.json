        "data"
      ]
    }
  ],
  "required": [
    "v",
    "id",
    "body",
    "sent_at"
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "Body": {
      "description": "Markdown, at most 32768 bytes after UTF-8 encoding.",
      "type": "string"
    },
    "Change": {
      "description": "One changed path in a DONE.",
      "type": "object",
      "properties": {
        "path": {
          "description": "The path, relative to the repository root.",
          "type": "string"
        },
        "status": {
          "description": "The `git diff --name-status` letter, such as `M` or `A`.",
          "type": "string"
        }
      },
      "required": [
        "status",
        "path"
      ]
    },
    "Check": {
      "description": "One check result in a DONE.",
      "type": "object",
      "properties": {
        "baseline": {
          "description": "Tests that failed on `base_sha`, when known.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "failed": {
          "description": "Tests that failed.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "name": {
          "description": "The check's name, such as `nextest`.",
          "type": "string"
        },
        "passed": {
          "description": "Tests that passed.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "name",
        "passed",
        "failed"
      ]
    },
    "DenyReason": {
      "description": "Why the hub refused a CLAIM.",
      "oneOf": [
        {
          "description": "Another identity holds the item.",
          "type": "string",
          "const": "held_by"
        },
        {
          "description": "The CLAIM arrived after its `valid_until`.",
          "type": "string",
          "const": "expired"
        },
        {
          "description": "The item is outside the claimant's lane.",
          "type": "string",
          "const": "not_in_lane"
        },
        {
          "description": "The item is closed.",
          "type": "string",
          "const": "closed"
        }
      ]
    },
    "Finding": {
      "description": "One finding in a REVIEW.",
      "type": "object",
      "properties": {
        "line": {
          "description": "The line, when one applies.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "path": {
          "description": "The file.",
          "type": "string"
        },
        "severity": {
          "description": "How bad it is.",
          "$ref": "#/$defs/FindingSeverity"
        },
        "trigger": {
          "description": "The input or state that shows it.",
          "type": "string"
        },
        "what": {
          "description": "What is wrong.",
          "type": "string"
        }
      },
      "required": [
        "severity",
        "path",
        "what",
        "trigger"
      ]
    },
    "FindingSeverity": {
      "description": "How bad a REVIEW finding is.",
      "oneOf": [
        {
          "description": "Low.",
          "type": "string",
          "const": "low"
        },
        {
          "description": "Medium.",
          "type": "string",
          "const": "med"
        },
        {
          "description": "High.",
          "type": "string",
          "const": "high"
        }
      ]
    },
    "GitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "IdentityId": {
      "type": "string",
      "pattern": "^[a-z0-9]{8,32}$"
    },
    "ItemKey": {
      "type": "string",
      "pattern": "^[A-Z]{1,4}-[0-9]{1,6}$"
    },
    "LaneName": {
      "type": "string",
      "pattern": "^L-[A-Z0-9-]{1,40}$"
    },
    "Mention": {
      "description": "all, agents, humans, a lane name (L-UI), role:<name>, or an identity id.",
      "type": "string"
    },
    "MessageId": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "Needs": {
      "description": "Who can clear an ALERT.",
      "oneOf": [
        {
          "description": "The first answer from the owner or a coordinator clears it.",
          "type": "string",
          "const": "anyone"
        },
        {
          "description": "It stays open for the owner after a coordinator answers.",
          "type": "string",
          "const": "owner"
        }
      ]
    },
    "Outcome": {
      "description": "A DECISION's outcome.",
      "oneOf": [
        {
          "description": "Go ahead.",
          "type": "string",
          "const": "GO"
        },
        {
          "description": "Stop.",
          "type": "string",
          "const": "VETO"
        }
      ]
    },
    "RoleName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$"
    },
    "Seq": {
      "description": "A stream's sequence number. The hub numbers each stream from 1 with no gaps.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "Severity": {
      "description": "How bad a FOUND problem is.",
      "oneOf": [
        {
          "description": "Low.",
          "type": "string",
          "const": "low"
        },
        {
          "description": "Medium.",
          "type": "string",
          "const": "med"
        },
        {
          "description": "High.",
          "type": "string",
          "const": "high"
        },
        {
          "description": "A security problem: the feed shows only its key and lane.",
          "type": "string",
          "const": "security"
        }
      ]
    },
    "Tokens": {
      "description": "Token counts in a STATUS.",
      "type": "object",
      "properties": {
        "cache_read": {
          "description": "Tokens read from the prompt cache.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "input": {
          "description": "Input tokens.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "output": {
          "description": "Output tokens.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "input",
        "output",
        "cache_read"
      ]
    },
    "Urgency": {
      "description": "An ALERT's urgency.",
      "oneOf": [
        {
          "description": "A notification.",
          "type": "string",
          "const": "normal"
        },
        {
          "description": "Adds the chime and the needs-you highlight.",
          "type": "string",
          "const": "urgent"
        }
      ]
    },
    "Verdict": {
      "description": "A REVIEW's verdict.",
      "oneOf": [
        {
          "description": "The work passes.",
          "type": "string",
          "const": "pass"
        },
        {
          "description": "The work needs changes.",
          "type": "string",
          "const": "changes"
        }
      ]
    }
  }
}
