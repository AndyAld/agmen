{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientEnvelope",
  "description": "What a client publishes to `up/{identity_id}`.\n\nParsing rejects fields protocol v1 does not define, so a client cannot\nsmuggle in `from` or another hub-stamped field. In Rust,\n`ClientEnvelope::from_json` also says which NACK reason a failure earns;\nplain serde deserialization applies the same rules.",
  "type": "object",
  "properties": {
    "body": {
      "description": "Markdown text.",
      "$ref": "#/$defs/Body"
    },
    "id": {
      "description": "A ULID the client generates; the dedupe key with `from`.",
      "$ref": "#/$defs/MessageId"
    },
    "items": {
      "description": "Items the message is about.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ItemKey"
      }
    },
    "lane": {
      "description": "The lane the message is about.",
      "anyOf": [
        {
          "$ref": "#/$defs/LaneName"
        },
        {
          "type": "null"
        }
      ]
    },
    "mentions": {
      "description": "Mentions; only FYI, ASK, ANSWER and ALERT take them.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Mention"
      }
    },
    "reply_to": {
      "description": "The id of an earlier message this one answers or threads under.",
      "anyOf": [
        {
          "$ref": "#/$defs/MessageId"
        },
        {
          "type": "null"
        }
      ]
    },
    "sent_at": {
      "description": "The client's clock when it sent the message; display only.",
      "type": "string",
      "format": "date-time"
    },
    "to": {
      "description": "Recipients: 1 to 8 on DM, 0 to 8 on ASK (an ASK with recipients goes\nto their inboxes, like a DM), and empty for every other verb. Parses\nfrom a list, `null`, or a missing field.",
      "type": [
        "array",
        "null"
      ],
      "default": [],
      "items": {
        "$ref": "#/$defs/IdentityId"
      }
    },
    "v": {
      "description": "Protocol version; 1.",
      "type": "integer",
      "format": "uint8",
      "maximum": 255,
      "minimum": 0
    },
    "valid_until": {
      "description": "When the message stops being valid; required on CLAIM.",
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "anyOf": [
    {
      "description": "Joins the room; the hub updates the roster.",
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "agent": {
              "description": "Coding agent and version, such as `claude-code/2.1.310`.",
              "type": [
                "string",
                "null"
              ]
            },
            "client": {
              "description": "Client name and version, such as `agmen-cli/0.1.0`.",
              "type": "string"
            },
            "looking_at": {
              "description": "What the sender is looking at, shown in the roster.",
              "type": [
                "string",
                "null"
              ]
            },
            "model": {
              "description": "Model the agent runs.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "client"
          ]
        },
        "verb": {
          "type": "string",
          "const": "HELLO"
        }
      },
      "required": [
        "verb",
        "data"
      ]
    },
    {
      "description": "Leaves the room; the hub sets presence offline.",
      "type": "object",
      "properties": {
        "data": {
          "type": "object"
        },
        "verb": {
          "type": "string",
          "const": "BYE"
        }
